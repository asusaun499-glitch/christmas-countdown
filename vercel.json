{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0"
    },
    "admin.php": {
      "runtime": "vercel-php@0.9.0"
    },
    "time.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "rewrites": [
    { "source": "/time.php", "destination": "/api/time.php" },
    { "source": "/admin", "destination": "/admin.php" }
  ]
}
